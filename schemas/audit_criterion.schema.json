{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metricsthinking.io/schemas/audit_criterion.schema.json",
  "title": "AuditCriterion",
  "description": "Validation contract for an individual audit criterion evaluated against physical ground truth.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^C[0-9]{2}_[0-9]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "weight": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "type": "string",
      "enum": ["done", "active", "backlog", "blocked"]
    },
    "score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "evidence_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": ["id", "name", "weight", "status", "score", "evidence_files", "evidence_count", "notes"],
  "additionalProperties": false
}
