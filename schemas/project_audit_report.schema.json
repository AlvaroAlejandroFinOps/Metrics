{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metricsthinking.io/schemas/project_audit_report.schema.json",
  "title": "ProjectAuditReport",
  "description": "Validation contract for complete MetricsThinking v3.0 Universal project audit reports.",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "project_path": {
      "type": "string"
    },
    "audit_date": {
      "type": "string"
    },
    "auditor": {
      "type": "string"
    },
    "profile_used": {
      "type": "string"
    },
    "domain_archetype": {
      "type": "string",
      "enum": [
        "software-engineering",
        "mlops",
        "llmops",
        "dataops",
        "gitops",
        "platform-eng",
        "devsecops",
        "dual-track",
        "team-topologies",
        "chaos-eng",
        "sdd",
        "data-platform",
        "web-app",
        "custom"
      ]
    },
    "inspection_mode": {
      "type": "string",
      "enum": [
        "source_code",
        "declarative_config",
        "pipeline_orchestration",
        "governance_spec",
        "polyglot_hybrid"
      ]
    },
    "git_commit": {
      "type": ["string", "null"]
    },
    "git_branch": {
      "type": ["string", "null"]
    },
    "seed_detected": {
      "type": "boolean"
    },
    "seed_version": {
      "type": ["string", "null"]
    },
    "evidence_primitives": {
      "type": "object"
    },
    "consolidated_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "maturity_band": {
      "type": "string"
    },
    "active_bottleneck": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module_id": { "type": "string" },
          "name": { "type": "string" },
          "weight": { "type": "number" },
          "stage_group": { "type": "string" },
          "phase_completion_pct": { "type": "number" },
          "weighted_contribution_pct": { "type": "number" },
          "status": { "type": "string" },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "criterion_id": { "type": "string" },
                "name": { "type": "string" },
                "fulfilled": { "type": "boolean" },
                "evidence_path": { "type": ["string", "null"] },
                "evidence_detail": { "type": "string" },
                "remediation_hint": { "type": ["string", "null"] }
              },
              "required": ["criterion_id", "name", "fulfilled"]
            }
          }
        },
        "required": ["module_id", "name", "weight", "criteria"]
      },
      "minItems": 10,
      "maxItems": 10
    },
    "remediation_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": { "type": "string" },
          "module_id": { "type": "string" },
          "criterion_id": { "type": "string" },
          "action": { "type": "string" },
          "impact_score": { "type": "number" },
          "files_to_touch": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["priority", "module_id", "criterion_id", "action", "impact_score"]
      }
    },
    "stats": {
      "type": "object"
    }
  },
  "required": [
    "project_name",
    "project_path",
    "audit_date",
    "profile_used",
    "domain_archetype",
    "inspection_mode",
    "modules"
  ],
  "additionalProperties": true
}
