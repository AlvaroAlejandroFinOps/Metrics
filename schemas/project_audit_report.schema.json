{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metricsthinking.io/schemas/project_audit_report.schema.json",
  "title": "ProjectAuditReport",
  "description": "Validation contract for complete MetricsThinking project audit reports.",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "project_path": {
      "type": "string"
    },
    "audit_timestamp": {
      "type": "string"
    },
    "overall_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "maturity_band": {
      "type": "string",
      "enum": [
        "Inception / Prototyping (0-24%)",
        "Foundational Development (25-49%)",
        "Functional Maturation (50-74%)",
        "Operational Excellence / Production Ready (75-89%)",
        "Enterprise Certified / Battle-Tested (90-100%)"
      ]
    },
    "status_distribution": {
      "type": "object",
      "properties": {
        "done": { "type": "integer", "minimum": 0 },
        "active": { "type": "integer", "minimum": 0 },
        "backlog": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      },
      "required": ["done", "active", "backlog", "blocked"],
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "canonical_module.schema.json"
      },
      "minItems": 10,
      "maxItems": 10
    },
    "evidence_summary": {
      "type": "object",
      "properties": {
        "total_files": { "type": "integer", "minimum": 0 },
        "total_dirs": { "type": "integer", "minimum": 0 },
        "total_code_lines": { "type": "integer", "minimum": 0 },
        "language_distribution": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "has_seed": { "type": "boolean" },
        "has_tests": { "type": "boolean" },
        "has_ci": { "type": "boolean" },
        "has_containerization": { "type": "boolean" }
      },
      "required": [
        "total_files",
        "total_dirs",
        "total_code_lines",
        "language_distribution",
        "has_seed",
        "has_tests",
        "has_ci",
        "has_containerization"
      ],
      "additionalProperties": false
    },
    "prioritized_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "module_id": { "type": "string" },
          "module_name": { "type": "string" },
          "action": { "type": "string" },
          "impact": { "type": "string" }
        },
        "required": ["priority", "module_id", "module_name", "action", "impact"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "project_name",
    "project_path",
    "audit_timestamp",
    "overall_score",
    "maturity_band",
    "status_distribution",
    "modules",
    "evidence_summary",
    "prioritized_actions"
  ],
  "additionalProperties": false
}
